# Generate three different 32+ character secrets inside an ignored mode-0700
# directory. File-backed Compose mounts need mode-0644 files for non-root UIDs.
PITLORE_POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres-admin-password
PITLORE_POSTGRES_MIGRATOR_PASSWORD_FILE=./secrets/postgres-migrator-password
PITLORE_POSTGRES_RUNTIME_PASSWORD_FILE=./secrets/postgres-runtime-password
# Keep loopback unless a TLS reverse proxy is intentionally exposing Registry.
PITLORE_REGISTRY_BIND_ADDRESS=127.0.0.1
PITLORE_REGISTRY_PORT=8787
# Optional comma-separated source IP/CIDR allow-list for an operator-controlled
# reverse proxy. Forwarded client-IP headers are ignored when this is empty.
# Never use 0.0.0.0/0, ::/0, true, or *.
PITLORE_TRUST_PROXY=

# Optional OIDC JWT verification. Configure all five values together.
PITLORE_OIDC_PROVIDER=
PITLORE_OIDC_ISSUER=
PITLORE_OIDC_AUDIENCE=
PITLORE_OIDC_ALGORITHMS=
PITLORE_OIDC_JWKS_URL=
PITLORE_OIDC_TENANT_CLAIM=org_id

# Optional browser authorization-code + PKCE flow. Configure all four values
# together, and configure the OIDC verifier above for the same identity provider.
PITLORE_BROWSER_AUTH_AUTHORIZE_URL=
PITLORE_BROWSER_AUTH_TOKEN_URL=
PITLORE_BROWSER_AUTH_CLIENT_ID=
PITLORE_BROWSER_AUTH_REDIRECT_URI=

# Self-hosted billing is off by default. This repository does not ship a real
# checkout/portal provider; the webhook fields only enable a separately supplied adapter.
PITLORE_BILLING_MODE=off
PITLORE_BILLING_PROVIDER=
# For enforced billing, mount a secret file in an operator-owned Compose override:
# PITLORE_BILLING_WEBHOOK_SECRET_FILE=/run/secrets/billing-webhook-secret
